# API base URL — the front-end prefixes every endpoint declared in
# `src/lib/api/endpoints.ts` with this value. Override per environment.
# Default: https://kaveriindustries.com/api
VITE_API_BASE_URL=https://kaveriindustries.com/api

# Public site URL used for canonical links, OpenGraph tags, and JSON-LD.
VITE_SITE_URL=https://kaveriindustries.com